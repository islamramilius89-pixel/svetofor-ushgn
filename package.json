{
  "name": "svetofor-ushgn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "dev:web": "next dev",
    "dev:api": "npm --prefix backend run start:dev",
    "setup": "npm install && npm --prefix backend install && npm --prefix backend run db:deploy && npm --prefix backend run db:seed",
    "test": "npm --prefix backend test && npm --prefix backend run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
